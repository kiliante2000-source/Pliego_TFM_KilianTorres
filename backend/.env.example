# Environment variables declared in this file are NOT automatically loaded by Prisma for the app runtime.
# The API loads them via dotenv.

DATABASE_URL="file:./dev.db"
JWT_SECRET="pliego-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="pliego_token"
PORT=45322
NODE_ENV=development
CORS_ORIGIN="http://127.0.0.1:45321"
FRONTEND_URL="http://127.0.0.1:45321"
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"
MAX_UPLOAD_BYTES=5242880
CHROME_PATH="/usr/local/bin/google-chrome"
